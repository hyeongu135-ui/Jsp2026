<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8" import="java.util.*"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>
	<%!public void getGrade() {}
	public String getGrade(int score) {
		if (score >= 90) {
			return "A";
		}else if(score >= 80){
			return "B";
		}else if(score >= 70){
			return "C";
		}else if(score >= 60){
			return "D";
		}else{
			return "F";
		}
	
	}%>
	<%! String name [] = {"김철수","이영희","박민수","최지우","정다은"};%>
	<%! int scores [] = {92,78,55,85,67};%>
	<table border=1>
		<tr>
			<th>번호</th>
			<th>이름</th>
			<th>점수</th>
			<th>등급</th>
			<th>그래프</th>
		</tr>
		<% for(int i = 0; i < name.length; i++){%>
			<%if(scores[i] < 60){ %>
			<tr style.color='#ffcccc' >
			<td><%=i%></td>
			<td><%=name[i]%></td>
			<td><%=scores[i]%></td>
			<td><%= getGrade(scores[i]) %></td>
			<td><div style.width='scroes[i]*3' style.background-color='red'></div></td>
			</tr>
			<%}else{ %>
			<tr>
			<td><%=i%></td>
			<td><%=name[i]%></td>
			<td><%=scores[i]%></td>
			<td><%= getGrade(scores[i]) %></td>
			<td><div style.width='scroes[i]*3' style.background-color='red'></div></td>
			</tr>
			<% } %>
		<%} %>
	</table>
</body>
</html>