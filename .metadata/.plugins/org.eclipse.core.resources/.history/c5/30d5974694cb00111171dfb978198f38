<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8" import="java.util.*"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>회원가입처리</title>
</head>
<body> 
	<%
		// 스크립트릿은 자바 코드만 가능함
		request.setCharacterEncoding("utf-8");
	
		// RequestJoin.jsp의 입력값 전부 받아올것 Request 객체를 통해
		// 정보를 꺼내오세요.
		String id = request.getParameter("id");
		String pass = request.getParameter("pass");
		String passchk = request.getParameter("passchk");
		String email = request.getParameter("email");
		String tel = request.getParameter("tel");
		String []hobby = request.getParameterValues("hobby");
		String job = request.getParameterValues("job");
		String age = request.getParameterValues("age");
		String info = request.getParameter("info");
		String msg = "";
	%>
	
	
	<% if(!pass.equals(passchk)){%>
	<!-- 자바스크립트 객체 종류
		1. 코어객체
		2. DOM객체
		3. BOM객체 ==> 브라우저에서 사용하는 객체
			= history객체는 브라우저가 현재 탭이나 창에서 방문했던 웹페이지들의
			  기록(Session History)을 관리하고 제어하는 객체이다.
			  *history.back() : 바로 이전 페이지로 이동(뒤로 가기)
			  *history.forward() : 바로 다음 페이지로 이동(앞으로 가기)
			  *history.go(n) : 지정한 상대적 위치만큼 이동(앞으로 가기)
			   	-history.go(1) : 앞으로 가기
			   	-history.go(0) : 현재페이지 
			   	-history.go(-1) : 뒤로 가기
	 -->
	<script type="text/javascript">
		alert("<%= msg %>");
		history.go(-1);
	</script>
		
	<% } %>
	<%-- <% if(passchk.equals("")){%>
	<script type="text/javascript">
		alert("비밀번호를 입력해주세요.");
		history.go(-1);
	</script>
	
	<%}else if(id.equals("")){%>
	<script type="text/javascript">
		alert("아이디를 입력해주세요.");
		history.go(-1);
	</script>
	
	<%}else if(email.equals("")){%>
	<script type="text/javascript">
		alert("이메일을 입력해주세요.");
		history.go(-1);
	</script>
	
	<%}else if(tel.equals("")){%>
	<script type="text/javascript">
		alert("전화번호를 입력해주세요.");
		history.go(-1);
	</script>
	<%}else{%> --%>
	
	<% if(id == null || id.isEmpty()){ 
		msg = "아이디를 입력하세요";
	}else if(pass==null || pass.isEmpty()){
		msg = "비밀번호를 입력하세요";
	}else{
		msg = "예외";
	}%>
		
	
	<h2>회원가입 출력정보</h2>
	<table border = "1">
	<tr><td>아이디</td><td><%=id %></td></tr>
	<tr><td>이메일</td><td><%=email %></td></tr>
	<tr><td>전화번호</td><td><%=tel %></td></tr>
	<tr><td>취미</td>
		<td><% for(int i = 0; i < hobby.length; i++){%>
					<%=hobby[i] %><br>
			<%} %></td></tr>
	<tr><td>직업</td>
			<td><% for(int i = 0; i < job.length; i++){%>
						<%=job[i] %><br>
				<%} %></td></tr>
	<tr><td>나이</td><td><% for(int i = 0; i < age.length; i++){%>
				<%=age[i] %><br>
		<%} %></td></tr>
		<tr><td>남기실 말은</td><td><%=info %></td></tr>
	</table>
<%-- 	<%} %> --%>
</body>
</html>