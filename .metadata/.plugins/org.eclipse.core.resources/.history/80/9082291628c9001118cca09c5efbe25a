<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8" import="java.util.*"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>
	<table>
		<tr>
			<th>숫자</th>
			<th>제곱</th>
			<th>구분</th>
		</tr>
		<%for(int i = 0; i <=19; i++){%>
		<tr>
			<td><%=i+1%3==0?"<b>"+(i+1)+"</b>":i+1%></td>
			<td><%=i*i%></td>
			<td><%=i*i%2==1?"홀수":"짝수"%></td>
			<%}%>
		
	</table>
</body>
</html>