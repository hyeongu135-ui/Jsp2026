<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8" import="java.util.*"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>
	<h1>구구단 2단 부터 9단까지</h1>
	<table>
		<tr>
			<%
			for (int i = 2; i < 10; i++) {
			%>
		
		<th>
			<%
			out.print(i + "단");
			%>
		</th>
		</tr>

		<%
		for (int j = 1; j < 10; j++) {
			int sum = (i * j);
		%>
		
			<tr><td><%=i + "x" + j + "=" + sum%></td></tr>
		<%
		}
		%>
		<%
		}
		%>
	</table>
</body>
</html>