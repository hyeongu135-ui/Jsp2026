<%@page import="org.apache.tomcat.util.descriptor.web.SetPublicIdRule"%>
<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8" import="java.util.*"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>
	<table border=1 style=text-align:"center">
	<%! int[] winNums = {3, 12, 19, 27, 33, 41};
		int count = 1;
		public int isWinning(int num){
			for(int i = 0; i < winNums.length; i++){
				if(winNums[i]==num){
					return 1;
				}
			}
		}
		%>
	
	<% for(int i = 0; i < 45; i ++){%>
		<%=isWinning(count)==1?"<td Style=background-color=gold><b>" +count+ "</b>":"<td>" +count+ "</td>")%>
	<% count++;} %>
	
	
	</table>
</body>
</html>