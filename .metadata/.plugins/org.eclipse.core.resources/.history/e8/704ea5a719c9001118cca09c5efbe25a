<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8" import="java.util.*"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>
	<h1>구구단 2단 부터 9단까지</h1>
	<table border = 1px>
		<tr>
			<%for (int i = 2; i < 10; i++) {%>
			<td>
			<%=i + "단"%><br>


		

		<%for (int j = 1; j < 10; j++) {
			int sum = (i * j);%>
		
			<%=i + "x" + j + "=" + sum%><br><hr>
			
		<%}%></td>
		
		<%}%></tr>
	</table>
</body>
</html>